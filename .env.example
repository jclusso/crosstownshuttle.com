# Copy to .env for local work. Never commit .env.
# On Netlify these live in Site configuration > Environment variables.

# The single password your parents type at /admin.
ADMIN_PASSWORD=pick-a-long-passphrase

# Signs the admin session cookie. Any long random string.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Optional. Where the band plays, for turning dates into times.
# BAND_TIMEZONE=America/New_York

# Optional. Lets the build read the saved shows so they land in the HTML too.
# SITE_ID=your-netlify-site-id
# NETLIFY_API_TOKEN=your-netlify-personal-access-token

# Optional. A Netlify build hook, pinged after a save so the HTML catches up.
# BUILD_HOOK_URL=https://api.netlify.com/build_hooks/xxxxxxxx
